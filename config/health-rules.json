{
  "version": "1.0",
  "dimensions": [
    { "id": "cpu", "name": "CPU", "weight": 15, "order": 1 },
    { "id": "memory", "name": "内存", "weight": 15, "order": 2 },
    { "id": "storage", "name": "存储", "weight": 20, "order": 3 },
    { "id": "thermal", "name": "温度与散热", "weight": 15, "order": 4 },
    { "id": "stability", "name": "稳定性", "weight": 15, "order": 5 },
    { "id": "network", "name": "网络", "weight": 10, "order": 6 },
    { "id": "security", "name": "安全与更新", "weight": 10, "order": 7 }
  ],
  "rules": [
    {
      "id": "CPU_USAGE_HIGH",
      "dimension": "cpu",
      "severity": "warning",
      "metricPath": "cpu.totalUsagePercent",
      "comparison": "greaterOrEqual",
      "threshold": 90,
      "consecutiveSamples": 5,
      "penalty": 20,
      "title": "CPU 使用率持续偏高",
      "description": "CPU 总使用率达到 {value:F1}%，高于规则阈值 {threshold:F1}%。",
      "possibleCauses": ["后台任务或编译任务持续占用", "散热不足导致降频", "驱动或系统服务异常"],
      "recommendations": ["在“进程”页面按 CPU 排序定位高占用进程", "检查电源计划和散热状态", "如持续异常，重启后再次检测"],
      "requiresAdministrator": false
    },
    {
      "id": "MEMORY_USAGE_HIGH",
      "dimension": "memory",
      "severity": "warning",
      "metricPath": "memory.usagePercent",
      "comparison": "greaterOrEqual",
      "threshold": 90,
      "consecutiveSamples": 5,
      "penalty": 25,
      "title": "内存使用率过高",
      "description": "内存使用率为 {value:F1}%，高于规则阈值 {threshold:F1}%。",
      "possibleCauses": ["应用程序内存泄漏", "同时运行的程序过多", "页面文件配置不合理"],
      "recommendations": ["检查 Top 10 内存进程", "关闭不必要的大型应用", "考虑增加物理内存"],
      "requiresAdministrator": false
    },
    {
      "id": "SYSTEM_DISK_LOW",
      "dimension": "storage",
      "severity": "critical",
      "metricPath": "disk.system.freePercent",
      "comparison": "lessThan",
      "threshold": 10,
      "penalty": 45,
      "title": "系统盘剩余空间不足",
      "description": "系统盘剩余空间仅 {value:F1}%，低于安全阈值 {threshold:F1}%。",
      "possibleCauses": ["临时文件或更新缓存占用", "大型应用或游戏安装在系统盘", "日志或报告文件未清理"],
      "recommendations": ["立即清理不需要的文件或迁移大型程序", "运行磁盘清理并清空回收站", "确认保留至少 10% 的系统盘空间"],
      "requiresAdministrator": true
    },
    {
      "id": "DISK_RESPONSE_HIGH",
      "dimension": "storage",
      "severity": "notice",
      "metricPath": "disk.averageResponseTimeMilliseconds",
      "comparison": "greaterThan",
      "threshold": 50,
      "consecutiveSamples": 3,
      "penalty": 12,
      "title": "磁盘平均响应时间偏高",
      "description": "磁盘平均响应时间为 {value:F1} ms，高于规则阈值 {threshold:F1} ms。",
      "possibleCauses": ["后台索引或更新任务", "机械硬盘随机读写瓶颈", "存储驱动异常"],
      "recommendations": ["等待后台任务结束复测", "检查磁盘健康与队列长度", "机械硬盘可考虑升级为 SSD"],
      "requiresAdministrator": false
    },
    {
      "id": "DISK_TEMPERATURE_HIGH",
      "dimension": "thermal",
      "severity": "warning",
      "metricPath": "disk.highestTemperatureCelsius",
      "comparison": "greaterThan",
      "threshold": 80,
      "penalty": 25,
      "title": "存储设备温度过高",
      "description": "最高磁盘温度为 {value:F1}°C，高于规则阈值 {threshold:F1}°C。",
      "possibleCauses": ["NVMe 散热片缺失或积灰", "长时间高负载读写", "机箱风道不畅"],
      "recommendations": ["检查 NVMe 散热和机箱风道", "暂停持续高负载任务并复测", "确认固件和存储驱动为厂商稳定版本"],
      "requiresAdministrator": true
    },
    {
      "id": "SSD_LIFE_LOW",
      "dimension": "storage",
      "severity": "critical",
      "metricPath": "disk.lowestRemainingLifePercent",
      "comparison": "lessThan",
      "threshold": 20,
      "penalty": 40,
      "title": "SSD 剩余寿命过低",
      "description": "SSD 估算剩余寿命为 {value:F1}%，低于规则阈值 {threshold:F1}%。",
      "possibleCauses": ["写入量较高", "设备接近设计耐久度", "存储健康数据异常"],
      "recommendations": ["立即备份重要数据", "使用厂商工具复核 SMART", "规划更换存储设备"],
      "requiresAdministrator": true
    },
    {
      "id": "BATTERY_HEALTH_LOW",
      "dimension": "stability",
      "severity": "warning",
      "metricPath": "system.batteryHealthPercent",
      "comparison": "lessThan",
      "threshold": 70,
      "penalty": 20,
      "title": "电池健康度偏低",
      "description": "电池满充容量为设计容量的 {value:F1}%，低于规则阈值 {threshold:F1}%。",
      "possibleCauses": ["电池自然老化", "长期高温环境使用", "电池校准数据偏差"],
      "recommendations": ["使用厂商工具复核电池健康", "外出时准备电源适配器", "如续航明显下降，考虑更换电池"],
      "requiresAdministrator": false
    },
    {
      "id": "DEFENDER_DISABLED",
      "dimension": "security",
      "severity": "critical",
      "metricPath": "system.defenderEnabled",
      "comparison": "isFalse",
      "penalty": 50,
      "title": "Microsoft Defender 未启用",
      "description": "检测到 Microsoft Defender 实时防病毒组件未启用。",
      "possibleCauses": ["安全中心配置被关闭", "第三方安全软件接管", "组策略或篡改防护限制"],
      "recommendations": ["打开 Windows 安全中心检查病毒和威胁防护", "确认是否有可信第三方安全软件接管", "不要关闭系统保护以提升性能"],
      "requiresAdministrator": true
    },
    {
      "id": "PENDING_REBOOT",
      "dimension": "stability",
      "severity": "notice",
      "metricPath": "system.pendingReboot",
      "comparison": "isTrue",
      "penalty": 8,
      "title": "系统存在待重启更新",
      "description": "检测到系统更新或组件安装正在等待重启。",
      "possibleCauses": ["Windows 更新需要重启完成", "驱动或组件安装等待生效"],
      "recommendations": ["保存工作后在合适时间重启电脑", "重启后再次执行快速检测确认状态"],
      "requiresAdministrator": false
    },
    {
      "id": "RESTRICTED_MODE",
      "dimension": "security",
      "severity": "information",
      "metricPath": "system.isAdministrator",
      "comparison": "isFalse",
      "penalty": 0,
      "title": "Agent 正以受限模式运行",
      "description": "当前未获得管理员权限，部分磁盘、安全和系统数据不可用。",
      "possibleCauses": ["便携模式未提权", "Windows 服务未正确安装", "安装或启动权限不足"],
      "recommendations": ["如需完整体检，请安装并启动 PulseCheck Agent 服务", "不要在不需要时长期使用管理员权限运行普通程序"],
      "requiresAdministrator": true
    }
  ]
}