{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "ProductName": "PulseCheck",
    "DisplayName": "",
    "ApiPort": 17821,
    "DiscoveryPort": 17820,
    "SampleIntervalMs": 1000,
    "RawRetentionDays": 7,
    "AggregateRetentionDays": 90,
    "EnableInternetProbe": false,
    "EnableUdpDiscovery": true,
    "RequireTls": true,
    "DataDirectory": "data",
    "ReportDirectory": "reports",
    "PairingCodeLifetimeMinutes": 15,
    "MaxReportHistory": 200
  }
}